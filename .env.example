# =============================================================================
# PROJECT SAMANVAYA - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env in the project root and link frontend/.env.local -> ../.env
# =============================================================================

# 1. SUPABASE POSTGRESQL & VECTOR ENGINE
# Used for storing encrypted visits, audit logs, ABHA accounts, and pgvector embeddings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-supabase-anon-key

# 2. NVIDIA NIM AI MICROSERVICES
# Primary clinical inference, multimodal document processing & diagnostic RAG
# Get keys at https://build.nvidia.com
NVIDIA_LLAMA_3_3_70B_KEY_1=nvapi-your-key-here
NVIDIA_LLAMA_3_3_70B_KEY_2=nvapi-optional-backup-key
NVIDIA_LLAMA_3_2_90B_KEY_1=nvapi-your-vision-key-here
NVIDIA_PHI_4_KEY_1=nvapi-your-ocr-key-here

# 3. SARVAM AI (INDIAN ACCENT MULTILINGUAL VOICE)
# Fast, low-latency Speech-to-Text (Saaras v3) and Text-to-Speech (Bulbul v3)
# Supports rotation across up to 8 keys for high-concurrency kiosks
SARVAM_API_KEY_1=sk_your-sarvam-key-here
# SARVAM_API_KEY_2=sk_optional-key-2
# SARVAM_API_KEY_3=sk_optional-key-3

# 4. GROQ LPU INFERENCE ENGINE (ULTRA-FAST TIER-1 ROUTING)
# Sub-250ms latency for voice intent routing, emergency keyword triage, and quick chips
# Get key at https://console.groq.com
GROQ_API_KEY=gsk_your-groq-key-here

# 5. DIGITAL INDIA BHASHINI (NATIONAL LANGUAGE TRANSLATION MISSION)
# Government of India ULCA translation, ASR & TTS across 22 Scheduled Languages
BHASHINI_USER_ID=your-bhashini-user-id
BHASHINI_ULCA_API_KEY=your-ulca-key
BHASHINI_INFERENCE_KEY=your-inference-key
